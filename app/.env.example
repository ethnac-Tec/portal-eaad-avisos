# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real tokens.

# Notion internal integration token (Notion → Settings → Connections → Develop or manage integrations).
# Remember to also share your avisos database with the integration from the "..." menu in Notion.
NOTION_TOKEN=

# The database ID, found in its URL:
# https://www.notion.so/yourworkspace/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=

# Optional: the value of your "Estado" property that means "ready to publish".
# Defaults to "Publicado" if unset.
NOTION_STATUS_VALUE=Publicado

# Firebase web app config (Firebase Console → Project settings → General →
# "Your apps" → add a Web app if you don't have one). These are NOT secret —
# they identify the project, safe to expose client-side and safe to commit
# to GitHub Actions as plain (non-secret) repo variables if you want.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Domain allowed to submit the professor form (checked client-side for UX
# AND re-checked server-side in the Cloud Function — never trust the client).
VITE_ALLOWED_EMAIL_DOMAIN=tec.mx
