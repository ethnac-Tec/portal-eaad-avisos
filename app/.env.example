# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real tokens.

# Notion internal integration token (Notion → Settings → Connections → Develop or manage integrations).
# Remember to also share your avisos database with the integration from the "..." menu in Notion.
NOTION_TOKEN=

# The database ID, found in its URL:
# https://www.notion.so/yourworkspace/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=

# Optional: the value of your "Estado" property that means "ready to publish".
# Defaults to "Publicado" if unset.
NOTION_STATUS_VALUE=Publicado
